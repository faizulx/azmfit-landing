---
// Hero — top fold, coach-first. AzmFit Coach is a SaaS for online
// coaches; the headline sells that, the primary CTA opens the live
// web app, and the secondary jumps to pricing. The client-side app is
// a separate (free) section below, so the hero stays single-audience.

interface Props {
  lang: "en" | "ar";
}

const { lang } = Astro.props;

const COACH_APP_URL = "https://app.azmfit.co";

const copy = {
  en: {
    eyebrow: "AzmFit Coach",
    headline: "Coach more clients, with less busywork.",
    tagline:
      "Build programs, review every client's week, and see who needs you — all in one studio. Your clients track workouts, meals, and recovery in a free companion app.",
    cta: "Get started",
    secondaryCta: "See pricing →",
    logoAlt: "AzmFit",
  },
  ar: {
    eyebrow: "عزم للمدربين",
    headline: "درّب متدربين أكثر، بمجهود أقل.",
    tagline:
      "من مكان واحد: ابنِ البرامج، راجع أسبوع كل متدرب، وشوف مين يحتاج اهتمامك. ومتدربينك يتابعون تمارينهم وأكلهم وتعافيهم في تطبيق مجاني.",
    cta: "ابدأ الآن",
    secondaryCta: "← شوف الأسعار",
    logoAlt: "عزم",
  },
}[lang];
---

<section class="hero">
  <div class="container hero-inner">
    {/* Brand wordmark — the Rise tally, sized large to anchor the hero.
        Reads on the Ink field (cream marks + cobalt stroke). */}
    <img class="logo" src="/azm-logo-dark-transparent.png" alt={copy.logoAlt} />
    <p class="eyebrow hero-eyebrow">{copy.eyebrow}</p>
    <h1 class="headline">{copy.headline}</h1>
    <p class="tagline">{copy.tagline}</p>

    <div class="cta-row">
      <a
        class="cta-primary"
        href={COACH_APP_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>{copy.cta}</span>
      </a>
      <a class="cta-secondary" href="#pricing">{copy.secondaryCta}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 80px;
    background: linear-gradient(
      180deg,
      var(--bone) 0%,
      var(--bone-container) 100%
    );
  }

  .hero-inner {
    text-align: center;
    max-width: 760px;
  }

  /* Brand wordmark — the transparent PNG carries padding around the
   * tally marks; negate it with a negative bottom margin so the mark
   * can be large without leaving a big gap to the eyebrow below. */
  .logo {
    display: inline-block;
    height: clamp(180px, 24vw, 280px);
    width: auto;
    margin-bottom: -56px;
  }

  .hero-eyebrow {
    margin-bottom: 14px;
  }

  .headline {
    font-family: var(--font-display);
    font-size: clamp(34px, 5.5vw, 56px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 20px;
  }

  .tagline {
    font-size: clamp(16px, 2vw, 19px);
    color: var(--muted);
    max-width: 600px;
    margin: 0 auto 36px;
    line-height: 1.5;
  }

  .cta-row {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: var(--on-accent);
    padding: 14px 30px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 15px;
    transition: background 160ms ease;
  }

  .cta-primary:hover {
    background: var(--accent-dim);
    text-decoration: none;
  }

  .cta-secondary {
    color: var(--ink);
    font-weight: 500;
    font-size: 15px;
  }
</style>
